{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nader",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "8c469faa-990e-4fd2-997e-71e2443013be","database_name": "nova-31227a-db" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "176898068f914547a7a6ddeb60eda2cf" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
